#!/usr/bin/bash
set -Eeuo pipefail
readonly ACTIVITY_ID=684219
readonly DISK=/dev/disk/by-id/usb-Samsung_PSSD_T7_Shield_S6YGNS0Y903440H-0:0
readonly STATE=/var/lib/t7-restic-backup/reminder.state

[[ -f $STATE ]] || { printf 'activity=%s reminder=no_state\n' "$ACTIVITY_ID"; exit 0; }
job_id=$(sed -n 's/^job_id=//p' "$STATE")
[[ $job_id =~ ^[A-Za-z0-9-]+$ ]] || exit 65
if [[ ! -e $DISK ]]; then
    printf 'activity=%s reminder=device_absent notification=no\n' "$ACTIVITY_ID"
    exit 0
fi
props=$(udevadm info --query=property --name "$DISK")
grep -Fxq 'ID_SERIAL_SHORT=S6YGNS0Y903440H' <<<"$props" || exit 66
mountpoint -q /mnt/T7_BACKUP && { printf 'activity=%s reminder=mounted notification=no\n' "$ACTIVITY_ID"; exit 67; }
/usr/local/libexec/t7-restic-notify reminder "$job_id"
