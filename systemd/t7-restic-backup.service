[Unit]
Description=Activity 684219 automatic backup when T7 is connected
Documentation=file:/usr/share/doc/fedora-t7-backup/OPERATIONS.md
After=systemd-udevd.service local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/t7-restic-lifecycle
LoadCredentialEncrypted=restic-password:/etc/credstore.encrypted/t7-restic-password
StateDirectory=t7-restic-backup
CacheDirectory=t7-restic-backup
RuntimeDirectory=t7-restic-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=20
IOWeight=20
TimeoutStartSec=12h
TimeoutStopSec=15min
KillSignal=SIGINT
Restart=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
