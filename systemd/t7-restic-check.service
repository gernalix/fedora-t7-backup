[Unit]
Description=Activity 583921 weekly Restic integrity check on T7
Documentation=file:/usr/share/doc/fedora-t7-backup/OPERATIONS.md
RequiresMountsFor=/mnt/T7_BACKUP
After=local-fs.target mnt-T7_BACKUP.mount

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/t7-restic-backup check-light
LoadCredentialEncrypted=restic-password:/etc/credstore.encrypted/t7-restic-password
StateDirectory=t7-restic-backup
CacheDirectory=t7-restic-backup
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
TimeoutStartSec=8h
TimeoutStopSec=15min
KillSignal=SIGINT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/mnt/T7_BACKUP /var/lib/t7-restic-backup /var/cache/t7-restic-backup /run/lock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
